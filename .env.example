# Copy this file to .env and fill in your own Garmin Connect credentials.
# .env is git-ignored — never commit real credentials.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Measured heart-rate bounds used for TRIMP / training load (bpm).
# Personal health data: keep them here, not in the code.
TRIDATA_HR_MAX=190
TRIDATA_HR_REST=60

# Food log web app (`tridata web`).
# Claude API key from your own Anthropic Console account (set a low spend limit there).
ANTHROPIC_API_KEY=
# Model that interprets what you write (Haiku is cheap; switch here, not in the code).
TRIDATA_MODELO_TEXTO=claude-haiku-5-5
# Daily expenditure = basal + default steps x kcal per step. These two values are used ONLY on the
# first start of `tridata web`, copied once as settings "since always"; after that they are changed
# in the app's Ajustes page (each with the date it applies from) and editing them here changes nothing.
# Example values: put yours.
TRIDATA_BASAL_KCAL=1500
TRIDATA_KCAL_POR_PASO=0.04
# Model that transcribes what you dictate, on this PC's GPU (needs the `voz` extra; switch here, not in the code).
TRIDATA_MODELO_VOZ=large-v3-turbo
# The Asistente's conversations: the model of each role of the team is chosen in the app, Ajustes › El equipo (Haiku
# by default; «Pensar más» uses Sonnet for one message). This value is only the fallback for a conversation without
# a model chosen there; changing it does not change the model of any role.
TRIDATA_MODELO_ASISTENTE=claude-haiku-5-5
# Folder with the PDFs of your blood tests and stress test, outside any repository. Each PDF is sent ONCE to the API
# to transcribe its values, which then live only in the local database and go in the Asistente's context.
TRIDATA_MEDICOS_DIR=/path/to/your/private/medical/folder
# Google Calendar (unit 043): path of the JSON of your Google OAuth client (type Desktop, scope
# calendar.app.created), outside any repository. The token is saved in ~/.tridata/google-token.json (600).
TRIDATA_GOOGLE_CLIENTE=/path/to/your/private/google/client.json
