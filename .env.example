# Copy this file to .env and fill in your own Garmin Connect credentials.
# .env is git-ignored — never commit real credentials.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password

# Measured heart-rate bounds used for TRIMP / training load (bpm).
# Personal health data: keep them here, not in the code.
TRIDATA_HR_MAX=190
TRIDATA_HR_REST=60

# Food log web app (`tridata web`).
# Claude API key from your own Anthropic Console account (set a low spend limit there).
ANTHROPIC_API_KEY=
# Model that interprets what you write (Haiku is cheap; switch here, not in the code).
TRIDATA_MODELO_TEXTO=claude-haiku-5-5
# Daily expenditure = basal + default steps x kcal per step. These two values are used ONLY on the
# first start of `tridata web`, copied once as settings "since always"; after that they are changed
# in the app's Ajustes page (each with the date it applies from) and editing them here changes nothing.
# Example values: put yours.
TRIDATA_BASAL_KCAL=1500
TRIDATA_KCAL_POR_PASO=0.04
