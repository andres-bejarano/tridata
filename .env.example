# Copy this file to .env and fill in your own values after each «=».
# .env is git-ignored — never commit real credentials. This file carries NO values on purpose: the repository is
# public, and every path below is personal.

# Your Garmin Connect account (only used to talk to Garmin).
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Measured heart-rate bounds used for TRIMP / training load (bpm).
# Personal health data: keep them here, not in the code.
TRIDATA_HR_MAX=
TRIDATA_HR_REST=

# Food log web app (`tridata web`).
# Daily expenditure = basal + default steps x kcal per step. These two values are used ONLY on the
# first start of `tridata web`, copied once as settings "since always"; after that they are changed
# in the app's Ajustes page (each with the date it applies from) and editing them here changes nothing.
TRIDATA_BASAL_KCAL=
TRIDATA_KCAL_POR_PASO=

# Unit 104: your ONE folder of personal papers of sport, outside any repository (e.g. a folder of your Drive synced
# on this PC). Inside it: health/ (the PDFs of your blood tests and stress test, read by the coach on the PC;
# with your «sí» their values are kept in the local database only), routes/ (GPX files; the coach reads no file
# outside this folder) and tridata-backup/ (`tridata backup` leaves there one compressed copy a day, the last 14;
# no credential ever goes in it). It replaces the old TRIDATA_MEDICOS_DIR. Without it, copies stay in
# ~/.tridata/backups.
TRIDATA_DOCS=

# Google Calendar (unit 043): path of the JSON of your Google OAuth client (type Desktop, scope
# calendar.app.created), outside any repository. The token is saved in ~/.tridata/google-token.json (600).
# Format: TRIDATA_GOOGLE_CLIENTE=/path/to/your/private/google/client.json
TRIDATA_GOOGLE_CLIENTE=

# Strava (unit 102, only read: the shoes in use and their km): path of a JSON {"client_id": ..., "client_secret": ...}
# of YOUR Strava application, outside any repository. Create it once in Strava › Ajustes › Mi API
# (https://www.strava.com/settings/api), with «Authorization Callback Domain» = localhost; then Ajustes › Strava ›
# «Conectar Strava» on this PC. The token is saved in ~/.tridata/strava-token.json (600).
TRIDATA_STRAVA_CLIENTE=

# Optional: extra host names (comma separated) the web app answers to, besides an IP, localhost, the machine's own
# name and the tailnet (*.ts.net).
TRIDATA_WEB_HOSTS=
