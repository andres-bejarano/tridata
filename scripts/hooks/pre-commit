#!/usr/bin/env bash
# Pre-commit hook (unit 105): nothing personal enters the repo, which is public.
# Turn it on once per clone:  git config core.hooksPath scripts/hooks
#   1. scripts/ci/ficheros_personales.py --staged: no PDFs, real GPX, inscripciones/, deficit*, .env*
#   2. gitleaks over what is staged: no secrets
# `scripts/ci/lint` runs the same file check over the whole tree, so `--no-verify` is caught there.
set -euo pipefail
hooks="$(cd "$(dirname "$0")" && pwd)"

if command -v python3 >/dev/null 2>&1; then py=python3; else py=python; fi
"$py" "$hooks/../ci/ficheros_personales.py" --staged

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks no está en el PATH, así que los secretos no se comprobarían." >&2
  echo "  Instala gitleaks 8.30.1 como dice AGENTS.md (versión fijada, SHA-256 comprobada)." >&2
  echo "  Para saltar esta comprobación a sabiendas: git commit --no-verify" >&2
  exit 1
fi
if ! gitleaks git --pre-commit --staged --redact --no-banner --log-level error .; then
  echo "pre-commit: gitleaks ha encontrado un secreto en lo preparado (arriba, ocultado). Sácalo del commit." >&2
  exit 1
fi
